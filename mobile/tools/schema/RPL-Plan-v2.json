        "fuel_strategy": "post.fuel", "exec_status": "post.status", "duration_min": "post.duration",
        "water_l": "post.water", "session_rpe": "post.sessionRpe", "joint_pain": "post.joint"
      },
      "required": ["week", "day"],
      "ranges": {"bw_kg": [30, 250], "sleep_h": [0, 16], "rhr_bpm": [20, 120], "hrv_ms": [0, 300], "duration_min": [0, 600], "water_l": [0, 20], "session_rpe": [1.0, 10.0], "joint_pain": [0, 10]},
      "enums": {
        "fuel_strategy": ["cut", "maintain", "bulk"],
        "exec_status": ["green", "amber", "red"],
        "readiness_free_text": true
      },
      "unique": ["week", "day"],
      "role_columns": {"week": "week", "day": "day"},
      "mirror_day_level": ["readiness", "bw"],
      "numeric_from": "ranges",
      "comment": "mirror_day_level：这些 bio 叶名同时写回日级同名字段（App 历史字段，CSV 导入也这么干）。列的数值/文本属性按它是否出现在 ranges 里判定，代码不写字段名白名单。"
    },

