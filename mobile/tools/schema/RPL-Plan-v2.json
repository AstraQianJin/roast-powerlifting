      "path": "weeks[week].auxDays",
      "columns": ["week", "item_idx", "domain", "item", "target", "intensity", "mon", "tue", "wed", "thu", "fri", "sat", "sun"],
      "keys": {"item_idx": "item_idx", "domain": "domain", "item": "item", "target": "target", "intensity": "intensity"},
      "day_columns": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"],
