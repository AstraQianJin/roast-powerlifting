      "required": ["week", "day", "row_idx", "gear_json"],
      "unique": ["week", "day", "row_idx"],
      "anchor_to": "Workouts",
      "defaults": { "source": "plan", "kind": "" },
      "role_columns": {"week": "week", "day": "day", "row": "row_idx", "kind": "kind", "source": "source", "gear_json": "gear_json"}
    }
  },

