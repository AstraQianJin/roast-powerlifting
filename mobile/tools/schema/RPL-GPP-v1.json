  "weekly_menu_note": "菜单每周不变（F5），变的是 done_mask 与实际记录值；用户可把任一行换成自定义条目（F27，存 state 随 GPP 表往返）。peak_ok:false 的条目在 Peak/Deload 周自动进回避名单（沿用现有处方 UI 阶段门控）。高 CNS 条目（行 4）与重日错开 ≥48h。",
  "recovery": {
    "formula": "REC = clamp(REC_base + B_gpp - F_gpp, 0.55, 1.25); recMult = REC",
    "rec_base_source": "RPL-JTS-v1.json#recMult.formula （REC_base = 0.75 + 0.50*(R/100)，R 为 JTS 六维准备度分）——本契约不复制该式，只拥有 B_gpp / F_gpp 两通道",
    "b_gpp": { "expr": "min(cap, Σ_当周项天 rec_bonus[item])", "cap": 0.08, "unit": "每完成项-天累加" },
    "f_gpp": { "expr": "min(cap, Σ_当周项天 fatigue[item])", "cap": 0.06, "unit": "每完成项-天累加" },
    "clamp": [0.55, 1.25],
    "landmark_debt": {
      "expr": "D_lower = Σ 项天 debt_lower[item]（neat_steps 仅计超过 debt_free_days 的天）; D_upper = Σ 项天 debt_upper[item]",
      "coefficients": { "mv": -0.3, "mev": -0.5, "mav": -0.8, "mrv": -1.0 },
      "note": "MV/MEV/MAV/MRV 扣减系数沿用现状（继承 cardioDebt，扩到全域），下限护栏不变。旧行 0/1/2 的 0.6/1.1/0.15(>5天) 原样迁到 zone2_walk/hiit_bike/neat_steps，历史周对账数字不变。"
    },
    "sru_bonus": {
      "expr": "薄弱链 SRU 加成按条目 sru_bonus（继承 weekPlannedSru，旧行级 1.5 改为按条目）",
      "migration_bound": "旧行 7/8/9 → 新条目的迁移保证：同一打卡模式下 SRU 变化 ≤±0.5/项天（迁移验收判据）"
    },
    "advisory_next_day": {
      "expr": "peak_ok:false 且当日完成 → 次日训练卡提示（展示层，不进乘数，不自动改组数——保持仅展示与推荐红线）",
