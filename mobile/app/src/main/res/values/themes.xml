<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RExDark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">#E53935</item>
        <!-- 红屏防御：Android 12+ 的边缘拉伸/回弹默认取 colorAccent（本项目是档位红），
             下拉到头会闪出一条红边。这里显式压成背景色；未真机证实成因，为防御性修复。 -->
        <item name="android:colorEdgeEffect">@color/window_bg</item>
    </style>
</resources>
