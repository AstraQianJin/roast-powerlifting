  "validation_rules": [
    {"id": "V001", "table": "PRESCRIPTION", "field": "exercise_id", "rule": "must exist in EXERCISE or EXERCISE_ALIAS", "severity": "error"},
    {"id": "V002", "table": "PRESCRIPTION", "field": "category_id", "rule": "must exist in CATEGORY", "severity": "error"},
    {"id": "V003", "table": "PRESCRIPTION", "field": "mode_id", "rule": "must exist in MODE", "severity": "error"},
    {"id": "V004", "table": "PRESCRIPTION", "field": "load_kg", "rule": "if pct_1rm and load_override=false: load = mround(anchor_1rm * pct_1rm, 2.5) within 2.5kg", "severity": "error"},
    {"id": "V005", "table": "PRESCRIPTION", "field": "week", "rule": "must be 1..sum(PHASE.work_weeks + PHASE.deload_weeks)", "severity": "error"},
    {"id": "V006", "table": "PRESCRIPTION", "field": "seq", "rule": "unique within (week, day_id); 1-based", "severity": "error"},
    {"id": "V007", "table": "PRESCRIPTION", "field": "sets", "rule": "sum per week/day must equal declared weekly total in PHASE", "severity": "warning"},
    {"id": "V008", "table": "PRESCRIPTION", "field": "day_id", "rule": "each day must have exactly one .Main lift unless exception flag", "severity": "warning"},
    {"id": "V009", "table": "MODE", "field": "mode_id", "rule": "24 canonical modes must all be present; legacy aliases must map to canonical", "severity": "error"},
